{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "bun-types"
    ],
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types"
    ]
  },
  "include": [
    "index.ts",
    "src",
    "test"
  ]
}
